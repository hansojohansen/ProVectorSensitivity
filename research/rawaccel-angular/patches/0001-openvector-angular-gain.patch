+			else if (t.speed_points < 1 || t.speed_points > ANGULAR_GAIN_MAX_SPEEDS) {
+				error("angular gain: speed count must be between 1 and 16");
+			}
+			else if (t.length != t.angle_points * t.speed_points) {
+				error("angular gain: number of gains must equal angles * speeds");
+			}
+			else {
+				if (t.speed_points > 1) {
+					if (!(t.speed_min > 0) || infnan(t.speed_min) || infnan(t.speed_max)) {
+						error("angular gain: min speed must be positive");
+					}
+					else if (!(t.speed_max > t.speed_min)) {
+						error("angular gain: max speed must be greater than min speed");
+					}
+				}
+
+				bool out_of_range = false;
+
+				for (int i = 0; i < t.length; i++) {
+					double g = t.data[i];
+					if (infnan(g) || !(g >= ANGULAR_GAIN_MIN && g <= ANGULAR_GAIN_MAX)) {
+						out_of_range = true;
+					}
+				}
+
+				if (out_of_range) {
+					error("angular gain: every gain must be between 0.5 and 2");
+				}
+			}
+		}

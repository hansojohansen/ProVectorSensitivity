+// OpenVector RESEARCH build only: angle x speed gain table.
+// Mirrors ra::angular_gain_args (common/rawaccel-base.hpp); field order and types must match.
+// JSON (inside a profile, optional; absent = off, so upstream settings files still load):
+//   "Angular gain table (RESEARCH ONLY)": {
+//     "angles": N,            // 1..128, grid theta_i = 360*i/N deg; 0 = right, 90 = down, 180 = left, 270 = up
+//     "speeds": M,            // 1..16, 1 = speed-independent
+//     "speedMin": s0,         // counts/ms (x 1000/DPI if device DPI set), first speed column, M > 1 only
+//     "speedMax": s1,         // last speed column, log-spaced in between, M > 1 only
+//     "gains": [ ... ]        // N*M values in [0.5, 2], row-major: gains[j*N + i] = g(theta_i, s_j)
+//   }
+[StructLayout(LayoutKind::Sequential)]
+public value struct AngularGainArgs
+{
+    literal int MaxAngles = ra::ANGULAR_GAIN_MAX_ANGLES;
+    literal int MaxSpeeds = ra::ANGULAR_GAIN_MAX_SPEEDS;
+    literal double MinGain = ra::ANGULAR_GAIN_MIN;
+    literal double MaxGain = ra::ANGULAR_GAIN_MAX;
+
+    [JsonProperty("angles")]
+    int anglePoints;
+
+    [JsonProperty("speeds")]
+    int speedPoints;
+
+    [JsonProperty("speedMin")]
+    double speedMin;
+
+    [JsonProperty("speedMax")]
+    double speedMax;
+
+    [JsonIgnore]
+    int length;
+
+    [JsonProperty("gains")]
+    [MarshalAs(UnmanagedType::ByValArray, SizeConst = ra::ANGULAR_GAIN_CAPACITY)]
+    array<float>^ gains;
+
+    [OnDeserialized]
+    void OnDeserializedMethod(StreamingContext context)
+    {
+        // gains->Length must match SizeConst when marshalling; the real count is kept in
+        // length so validation can reject a table whose size is not angles * speeds
+        length = gains == nullptr ? 0 : gains->Length;
+        Array::Resize(gains, (int)ra::ANGULAR_GAIN_CAPACITY);
+    }
+};
+

+			static_assert(ANGULAR_GAIN_MAX_ANGLES == 128 && ANGULAR_GAIN_MAX_SPEEDS == 16, "update error msg");
+			static_assert(ANGULAR_GAIN_MIN == 0.5 && ANGULAR_GAIN_MAX == 2, "update error msg");

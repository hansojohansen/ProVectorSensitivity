     static_assert(alignof(io_base) == alignof(modifier_settings) && alignof(modifier_settings) == alignof(device_settings));
 
+    /// <summary>
+    /// RESEARCH ONLY (OpenVector, not upstream Raw Accel).
+    /// Stateless lookup of the angle x speed gain table described at angular_gain_args.
+    /// (dx, dy) is the raw input packet in counts, speed is |(dx, dy)| in Raw Accel input
+    /// units (counts/ms, times 1000/DPI if the device DPI is set).
+    /// Bilinear: linear in angle with periodic wrap, linear in log(speed), clamped at the
+    /// speed ends. No allocation, no state, O(1).
+    /// Safe on an unvalidated table (the driver never runs valid()): sizes are bounds-checked
+    /// here, non-finite intermediate values fall back to safe defaults, and the result is
+    /// clamped to [ANGULAR_GAIN_MIN, ANGULAR_GAIN_MAX]. NaN checks use the bit pattern
+    /// (infnan) because the driver is compiled with /fp:fast.
+    /// </summary>
+    inline double angular_gain_lookup(const angular_gain_args& t, double dx, double dy, double speed)
+    {
+        const int n = t.angle_points;
+        const int m = t.speed_points;
+
+        if (n < 1 || n > ANGULAR_GAIN_MAX_ANGLES || m < 1 || m > ANGULAR_GAIN_MAX_SPEEDS) {
+            return 1;
+        }
+
+        if (dx == 0 && dy == 0) {
+            return 1;
+        }
+
+        // angle: atan2 in (-pi, pi] -> [0, 2pi] -> grid position in [0, n]
+        double theta = atan2(dy, dx);
+        if (theta < 0) theta += 2 * M_PI;
+
+        double pos = theta * (n / (2 * M_PI));
+        if (infnan(pos) || pos < 0) pos = 0;
+
+        int i0 = static_cast<int>(pos);
+        double fa = pos - i0;
+
+        if (i0 >= n) {
+            // theta rounded to exactly 2pi, which is the same direction as 0
+            i0 = 0;
+            fa = 0;
+        }
+
+        int i1 = (i0 + 1 >= n) ? 0 : i0 + 1;
+
+        // speed: position on the log-spaced grid in [0, m - 1]
+        int j0 = 0;
+        double fs = 0;
+
+        if (m > 1) {
+            double u = log(speed / t.speed_min) / log(t.speed_max / t.speed_min) * (m - 1);
+
+            if (infnan(u) || u < 0) u = 0;
+            else if (u > m - 1) u = m - 1;
+
+            j0 = static_cast<int>(u);
+            if (j0 > m - 2) j0 = m - 2;
+            fs = u - j0;
+        }
+
+        const float* row = t.data + j0 * n;
+        double g = row[i0] + fa * (double(row[i1]) - row[i0]);
+
+        if (m > 1) {
+            const float* next = row + n;
+            double g_next = next[i0] + fa * (double(next[i1]) - next[i0]);
+            g += fs * (g_next - g);
+        }
+
+        if (infnan(g)) return 1;
+
+        return clampsd(g, ANGULAR_GAIN_MIN, ANGULAR_GAIN_MAX);
+    }
